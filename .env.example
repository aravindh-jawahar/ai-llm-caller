# Copy this file to .env and fill in your real values.
# .env is gitignored; .env.example is safe to commit.

# Which provider to use: nvidia | openai | gemini | ollama
AI_PROVIDER=nvidia

# Optional: override the provider's default model (leave unset to use the default)
# AI_MODEL=openai/gpt-oss-20b

# API keys — only the one for your selected provider is required.
NVIDIA_API_KEY=your-nvidia-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here
# (ollama runs locally and needs no key)

# Trello — used by scripts/trello.sh for ticket tracking.
# Key + token: https://trello.com/power-ups/admin (create a Power-Up, then
# generate an API key and a token for it).
# Board ID: open the board and append .json to the URL — the top-level "id".
TRELLO_KEY=your-trello-api-key-here
TRELLO_TOKEN=your-trello-token-here
TRELLO_BOARD=your-trello-board-id-here
